# Keep stable image tags.
BOOKSTACK_IMAGE=lscr.io/linuxserver/bookstack:latest
BOOKSTACK_MARIADB_IMAGE=lscr.io/linuxserver/mariadb:latest

# Shared reverse proxy network and hostname.
BOOKSTACK_PROXY_NETWORK=proxy
BOOKSTACK_HOSTNAME=bookstack.home.bernardolab.it

# Local technical persistence.
BOOKSTACK_RUNTIME_PATH=/data/runtime/bookstack
BOOKSTACK_DB_PATH=/data/db/bookstack-mariadb

# NAS-backed writable app content and backups.
BOOKSTACK_CONTENT_PATH=/mnt/nas/data/apps/bookstack/uploads
BOOKSTACK_BACKUPS_PATH=/mnt/nas/backups/bookstack

# Runtime identity.
BOOKSTACK_PUID=1001
BOOKSTACK_PGID=100
BOOKSTACK_TZ=Etc/UTC

# App settings.
BOOKSTACK_APP_KEY=replace-with-generated-bookstack-app-key
BOOKSTACK_APP_URL=http://bookstack.home.bernardolab.it

# MariaDB settings.
BOOKSTACK_DB_NAME=bookstackapp
BOOKSTACK_DB_USER=bookstack
BOOKSTACK_DB_PASSWORD=replace-with-strong-bookstack-db-password
BOOKSTACK_DB_ROOT_PASSWORD=replace-with-strong-bookstack-root-password
