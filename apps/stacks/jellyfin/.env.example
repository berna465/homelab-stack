# Keep stable image tag.
JELLYFIN_IMAGE=jellyfin/jellyfin:10.10.7

# Shared reverse proxy routing.
JELLYFIN_PROXY_NETWORK=proxy
JELLYFIN_HOSTNAME=jellyfin.home.bernardolab.it

# Local technical persistence.
JELLYFIN_CONFIG_PATH=/data/runtime/jellyfin/config
JELLYFIN_CACHE_PATH=/data/cache/jellyfin

# NAS media library paths (read-only mounts in compose).
JELLYFIN_MEDIA_MOVIES_PATH=/mnt/nas/media/Movies
JELLYFIN_MEDIA_TV_PATH=/mnt/nas/media/tv
JELLYFIN_MEDIA_MUSIC_PATH=/mnt/nas/media/Music

# Optional backups path.
JELLYFIN_BACKUPS_PATH=/mnt/nas/backups/jellyfin

JELLYFIN_TZ=Etc/UTC
