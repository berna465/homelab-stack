# Fixed host port for direct access.
MEMOS_PORT=5230

# Keep a stable image tag to avoid surprise upgrades.
MEMOS_IMAGE=ghcr.io/usememos/memos:stable

# Local runtime data on VM data disk.
MEMOS_DATA_PATH=/data/runtime/memos

# Optional NAS export path for periodic exports/backups.
MEMOS_EXPORTS_PATH=/mnt/nas/backups/memos
