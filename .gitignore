# Python / virtualenv (se mai servirà)
__pycache__/
*.pyc
.venv/
venv/

# Editor
.vscode/
.idea/
*.swp

# Logs
logs/
*.log

# Secrets locali (fuori da git)
secrets/*
!secrets/.gitignore

# Config locali per ambienti
config/*.local.yaml
config/envs/*.local.yaml
# Config reali (non committare quella produttiva)
config/homelab.yaml

# Secrets
config/secrets/
*.env
.env.*

# Keep sample env files tracked
!**/.env.example
