# Ambiente di default
HOMELAB_ENV=lab

# --- Parametri Proxmox/nodo ---
PVE_NODE_NAME="pve-node1"

# ID template Debian 12 docker-ready
PVE_TEMPLATE_ID=902

# Storage VM (per i dischi delle VM)
PVE_STORAGE="local-lvm"

# Bridge di rete
PVE_BRIDGE_LAN="vmbr0"        # LAN 192.168.178.0/24
PVE_BRIDGE_INTERNAL="vmbr2"   # 10.10.0.0/24 (app / backend)
PVE_BRIDGE_MGMT="vmbr3"       # 172.16.0.0/24 (ssh mgmt se lo usi)

# --- VM: infra-core ---
INFRA_CORE_VMID=110
INFRA_CORE_NAME="infra-core"
INFRA_CORE_IP_MGMT="172.16.0.10"   # su vmbr3 (opzionale)
INFRA_CORE_IP_INTERNAL="10.10.0.10" # se la fai dual-homed

# --- VM: apps-core ---
APPS_CORE_VMID=120
APPS_CORE_NAME="apps-core"
APPS_CORE_IP_INTERNAL="10.10.0.20"

# In futuro puoi fare altri file env per ambienti diversi (dev/prod)
