# Proxmox node and template
PVE_NODE_NAME=pve-node1
PVE_TEMPLATE_ID=902
PVE_STORAGE=local-lvm

# homelab-core VM settings
VM_ID=110
VM_NAME=homelab-core
VM_CORES=2
VM_MEMORY_MB=2048
VM_DISK_SIZE=20G
VM_BRIDGE=vmbr0
VM_IP_CIDR=192.168.10.50/24
VM_GATEWAY=192.168.10.1
VM_CIUSER=debian

# SSH
VM_SSH_PUBLIC_KEY_FILE=${HOME}/.ssh/id_rsa.pub
VM_SSH_PRIVATE_KEY_FILE=${HOME}/.ssh/id_rsa
VM_SSH_PORT=22
# Optional override; defaults to VM_IP_CIDR host part.
# VM_SSH_HOST=192.168.10.50

# Optional remote install path
REMOTE_APP_DIR=/opt/homelab-core
