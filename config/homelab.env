# Proxmox node and template
PVE_NODE_NAME=pve-node1
PVE_TEMPLATE_ID=902
PVE_STORAGE=local-lvm

# homelab-core VM settings
VM_ID=111
VM_NAME=homelab-core
VM_CORES=2
VM_MEMORY_MB=2048
VM_DISK_SIZE=20G
VM_BRIDGE=vmbr0
VM_IP_CIDR=192.168.178.105/24
VM_GATEWAY=192.168.178.1
VM_CIUSER=debian

# SSH
VM_SSH_PUBLIC_KEY_FILE=${HOME}/.ssh/id_rsa.pub
VM_SSH_PRIVATE_KEY_FILE=${HOME}/.ssh/id_rsa
VM_SSH_PORT=22
# Optional override; defaults to VM_IP_CIDR host part.
# VM_SSH_HOST=192.168.178.105
# Optional SSH user override for `run-homelab.sh bootstrap`.
# VM_BOOTSTRAP_USER=ubuntu

# Optional remote install path
REMOTE_APP_DIR=/home/debian/homelab-core


# Template builder defaults (scripts/proxmox/build_template.sh)
TEMPLATE_OS=debian
TEMPLATE_ID=902
TEMPLATE_NAME=debian12-cloud-template
TEMPLATE_MEMORY_MB=2048
TEMPLATE_CORES=2
TEMPLATE_BRIDGE=vmbr0
TEMPLATE_STORAGE=local-lvm
TEMPLATE_SNIPPET_STORAGE=local
# FORCE_RECREATE=1
