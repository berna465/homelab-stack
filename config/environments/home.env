# Ambiente
ENV_NAME=home

# Template
TEMPLATE_VMID=902
TEMPLATE_STORAGE=local-lvm

# DNS
DNS_SERVER=192.168.178.1
DNS_SEARCH=fritz.box

# Default risorse
DEFAULT_CORES=4
DEFAULT_MEMORY=8192

########################################
# infra-core
########################################

INFRA_CORE_VMID=110
INFRA_CORE_NAME=infra-core

INFRA_CORE_CORES=4
INFRA_CORE_MEMORY=8192

INFRA_CORE_NET0_BRIDGE=vmbr0
INFRA_CORE_NET0_IP=192.168.178.50/24
INFRA_CORE_NET0_GW=192.168.178.1

INFRA_CORE_NET1_BRIDGE=vmbr2
INFRA_CORE_NET1_IP=10.10.0.2/24

########################################
# apps-core
########################################

APPS_CORE_VMID=111
APPS_CORE_NAME=apps-core

APPS_CORE_CORES=4
APPS_CORE_MEMORY=8192

APPS_CORE_NET0_BRIDGE=vmbr2
APPS_CORE_NET0_IP=10.10.0.3/24
APPS_CORE_NET0_GW=10.10.0.1
