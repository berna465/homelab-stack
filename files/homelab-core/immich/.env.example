# Fixed host port for direct access.
IMMICH_PORT=2283

# Keep aligned with the official Immich compose model.
IMMICH_VERSION=release
IMMICH_REDIS_IMAGE=redis:7-alpine

# NAS-backed writable app content and backups.
UPLOAD_LOCATION=/mnt/nas/data/apps/immich/library
IMMICH_BACKUPS_PATH=/mnt/nas/backups/immich

# Local technical persistence.
DB_DATA_LOCATION=/data/db/immich-postgres
IMMICH_MODEL_CACHE_LOCATION=/data/runtime/immich/model-cache
IMMICH_REDIS_PATH=/data/cache/immich-redis

# Database settings (official variable names).
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
DB_DATABASE_NAME=immich

# Immich runtime.
TZ=Etc/UTC
