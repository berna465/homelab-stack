# Fixed host port for direct access.
IMMICH_PORT=2283

# Keep stable image tags.
IMMICH_SERVER_IMAGE=ghcr.io/immich-app/immich-server:release
IMMICH_ML_IMAGE=ghcr.io/immich-app/immich-machine-learning:release
IMMICH_REDIS_IMAGE=redis:7.4-alpine
IMMICH_POSTGRES_IMAGE=tensorchord/pgvecto-rs:pg14-v0.3.0

# Local technical persistence.
IMMICH_POSTGRES_PATH=/data/db/immich-postgres
IMMICH_REDIS_PATH=/data/cache/immich-redis
IMMICH_MODEL_CACHE_PATH=/data/runtime/immich/model-cache

# NAS-backed writable app content and backups.
IMMICH_LIBRARY_PATH=/mnt/nas/data/apps/immich/library
IMMICH_BACKUPS_PATH=/mnt/nas/backups/immich

# Database settings.
IMMICH_DB_USER=immich
IMMICH_DB_PASSWORD=replace-with-strong-password
IMMICH_DB_NAME=immich

# Immich runtime.
TZ=Etc/UTC
