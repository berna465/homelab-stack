# Fixed host port for v1 direct access.
JOURNIV_PORT=8010

# Keep a stable image tag to avoid surprise upgrades.
JOURNIV_IMAGE=swalabtech/journiv-app:latest

# Persistent data location on the VM host.
JOURNIV_DATA_PATH=/opt/journiv/data

# Required app settings.
SECRET_KEY=replace-with-generated-secret-key
DOMAIN_NAME=192.168.178.210

# PostgreSQL settings.
POSTGRES_USER=journiv
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=journiv_prod

# Celery defaults from official compose.
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_MAX_MEMORY_PER_CHILD_KB=300000
CELERY_WORKER_MAX_TASKS_PER_CHILD=200
